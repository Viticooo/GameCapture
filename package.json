{
  "name": "gamecapture",
  "private": true,
  "version": "1.0.0",
  "description": "Captura tu Nintendo Switch en la PC con latencia ultrabaja",
  "author": {
    "name": "GameCapture",
    "email": "dev@gamecapture.local"
  },
  "homepage": "https://example.com/gamecapture",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "build:linux": "vite build && electron-builder --linux",
    "build:win": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.gamecapture.app",
    "productName": "GameCapture",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.4",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}